# ==============================================================================
# Insta Genie Agent - Environment Configuration
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mode Configuration
# ------------------------------------------------------------------------------
# Set to 'true' to run in mock mode without consuming real API credits or posting to IG
DRY_RUN=false
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. Cloudflare Workers AI Configuration
# ------------------------------------------------------------------------------
# Get your Account ID from Cloudflare Dashboard (Overview > Right sidebar)
# Get your API Token with "Workers AI Read" permissions from Dashboard > My Profile > API Tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# AI Models (Defaults are optimal for performance and visual fidelity)
# Text/Caption Model: @cf/meta/llama-3.3-70b-instruct-fp8-fast or @cf/meta/llama-3-8b-instruct
CF_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Image Generation Model: @cf/black-forest-labs/flux-1-schnell or @cf/bytedance/stable-diffusion-xl-lightning
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ------------------------------------------------------------------------------
# 3. Meta Instagram Graph API Configuration
# ------------------------------------------------------------------------------
# Requires:
# 1. Instagram Professional / Business / Creator Account
# 2. Instagram linked to a Facebook Page
# 3. Meta App with 'instagram_basic', 'instagram_content_publish', 'pages_read_engagement' permissions
# 4. Long-Lived User Access Token or Page Access Token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_long_lived_meta_access_token_here
META_GRAPH_API_VERSION=v20.0

# ------------------------------------------------------------------------------
# 4. Public Image Hosting Options (Instagram requires a public HTTPS image URL)
# ------------------------------------------------------------------------------
# Supported providers: "imgbb", "cloudinary", "s3", "r2", "direct_url", "local_proxy"
IMAGE_HOST_PROVIDER=imgbb

# Free ImgBB API key (Easiest to setup: https://api.imgbb.com/)
IMGBB_API_KEY=your_imgbb_api_key_here

# Cloudinary (Optional):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 / AWS S3 (Optional):
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# 5. Automation & Scheduling Configuration
# ------------------------------------------------------------------------------
# Scheduled auto-posting interval in hours (e.g., every 6 hours)
SCHEDULE_INTERVAL_HOURS=6
# Default topic pool for autonomous mode (comma separated)
DEFAULT_TOPICS=AI Innovation & Robotics,Modern Minimalist Architecture,Healthy High-Protein Recipes,Future Tech & Cyberpunk Aesthetics,Daily Mindful Motivation
